# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# Supabase → Project Settings → API (ou "Connect" no topo do painel).
#
# Estes dois valores são públicos por natureza (vão dentro do app no navegador).
# A segurança dos dados vem das regras RLS no banco.
# NUNCA coloque aqui a service_role / secret key.

# Ex.: https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Publishable key (sb_publishable_...) ou a "anon public" key (eyJ...)
VITE_SUPABASE_PUBLISHABLE_KEY=
